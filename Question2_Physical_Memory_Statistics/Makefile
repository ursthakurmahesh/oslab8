# Question 2: Physical Memory Statistics
# Makefile integration snippet for xv6-public

# Add _memtest to UPROGS in xv6 Makefile:
# UPROGS=\
#   _cat\
#   _echo\
#   _forktest\
#   _grep\
#   _init\
#   _kill\
#   _ln\
#   _ls\
#   _mkdir\
#   _rm\
#   _sh\
#   _stressfs\
#   _usertests\
#   _wc\
#   _zombie\
#   _memtest\

# Add memtest.c and meminfo.h to EXTRA:
# EXTRA=\
#   memtest.c meminfo.h\

# Build instructions:
# 1. Copy kalloc.c, vm.c, sysproc.c, syscall.c, syscall.h, defs.h, user.h, usys.S to xv6/
# 2. Copy memtest.c, meminfo.h to xv6/
# 3. make clean && make qemu-nox
# 4. Run `memtest`
